# ══════════════════════════════════════════════════════════════
# Crypto Trading Bot — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it's in .gitignore already.
# ══════════════════════════════════════════════════════════════


# ── Telegram Bot (free) ────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the token it gives you
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# 3. Start your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat" → "id" in the response
TELEGRAM_CHAT_ID=987654321


# ── AI: Groq (free tier — 14,400 req/day) ─────────────────────
# Sign up free at https://console.groq.com
# Free models available: llama3-8b-8192, mixtral-8x7b-32768
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── AI: Ollama (local, optional — no key needed) ──────────────
# Install: bash scripts/setup_ollama.sh
# Runs at http://localhost:11434 automatically
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral


# ── Exchange: Binance ──────────────────────────────────────────
# For PAPER TRADING, leave these empty (uses public data only)
# For LIVE TRADING, create READ + TRADE only keys at:
#   https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Disable "Withdrawals" permission on the API key!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=


# ── Freqtrade REST API ─────────────────────────────────────────
# These protect the local Freqtrade UI/API (http://localhost:8080)
FREQTRADE_API_USER=botuser
FREQTRADE_API_PASS=changeme_to_something_strong
FREQTRADE_JWT_SECRET=change_this_to_64_random_chars_minimum


# ── Dashboard API Server ───────────────────────────────────────
FREQTRADE_API_URL=http://localhost:8080
SESSION_SECRET=change_this_to_a_long_random_string
NODE_ENV=development
PORT=5000
