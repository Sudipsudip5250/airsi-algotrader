# ══════════════════════════════════════════════════════════════
# Crypto Trading Bot — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it's in .gitignore already.
# ══════════════════════════════════════════════════════════════


# ── Telegram Bot (free) ────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the token it gives you
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Start your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat" → "id" in the response
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── AI Providers (free-first: Ollama if running → Groq → HuggingFace → OpenRouter :free → plain text) ──
# Paid models are skipped unless AI_ALLOW_PAID=1. Routine research should stay on free/local providers.

# Set to 1 only for a human-triggered, high-value call. Default keeps the system on free/low models.
AI_ALLOW_PAID=0

# AI: Ollama (local, free, no API key needed) — preferred when reachable
# Install: bash scripts/setup_ollama.sh
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# AI: Groq (free tier)
# Sign up: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# AI: HuggingFace Inference API (free tier, rate-limited)
# Sign up: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# AI: OpenRouter — use a :free model unless AI_ALLOW_PAID=1
# Sign up: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AIRSI AlgoTrader


# ── Exchange: Binance ──────────────────────────────────────────
# For PAPER TRADING, leave these empty (uses public data only)
# For LIVE TRADING, create READ + TRADE only keys at:
#   https://www.binance.com/en/my/settings/api-management
# IMPORTANT: Disable "Withdrawals" permission on the API key!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=


# ── Freqtrade REST API ─────────────────────────────────────────
# These protect the local Freqtrade UI/API (http://localhost:8080)
FREQTRADE_API_USER=your_freqtrade_api_user_here
FREQTRADE_API_PASS=your_strong_freqtrade_password_here
FREQTRADE_JWT_SECRET=generate_a_random_secret_at_least_64_characters


# ── Dashboard API Server ───────────────────────────────────────
FREQTRADE_API_URL=http://localhost:8080
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Live market intelligence ─────────────────────────────────
# Public market/news data plus an optional free/local LLM.
# Leave LLM_API_KEY empty to use deterministic risk rules only (recommended default).
# Do not set LLM_MODEL to a paid OpenAI model unless AI_ALLOW_PAID=1.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
NEWS_RSS_URLS=
INTELLIGENCE_POLL_SECONDS=900
INTELLIGENCE_TTL_SECONDS=1800
INTELLIGENCE_DECISION_PATH=bot/user_data/market_intelligence.json
# Missing or expired intelligence fails closed for live/dry-run entries.
# Backtests and hyperopt ignore external intelligence by design.
