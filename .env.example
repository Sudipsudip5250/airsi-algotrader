# ══════════════════════════════════════════════════════════════
# Crypto Trading Bot — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git — it's in .gitignore already.
# ══════════════════════════════════════════════════════════════


# ── Telegram Bot (free) ────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot
# 2. Copy the token it gives you
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. Start your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Find "chat" → "id" in the response
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# ── AI Providers (API-only, free-first, no local daemon) ──
# Order: Groq free → Gemini Flash free → HuggingFace free → OpenRouter :free
# → Pollinations keyless (free-trial last resort) → deterministic plain text.
# Paid models are skipped unless AI_ALLOW_PAID=1.

# Set to 1 only for a human-triggered, high-value call.
AI_ALLOW_PAID=0

# AI: Groq (free tier, no card) — primary
# Sign up: https://console.groq.com
# Sep 2026: llama-3.1-8b-instant + llama-3.3-70b-versatile SHUT DOWN 08/16/26 (free/dev).
# Use openai/gpt-oss-20b (fast, default) or openai/gpt-oss-120b / qwen/qwen3-32b (quality).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# AI: Gemini Flash (free tier, Google account, no card) — secondary
# Sign up: https://aistudio.google.com/app/apikey
# Current: gemini-2.5-flash (use OpenAI-compatible endpoint, handled in code)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# AI: HuggingFace Inference API (free tier, rate-limited)
# Sign up: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# AI: OpenRouter — use openrouter/free router or a :free model unless AI_ALLOW_PAID=1
# Sign up: https://openrouter.ai/keys
# Current Sep 2026 free rotates; openrouter/free auto-picks. Pinned alts:
# openai/gpt-oss-20b:free, meta-llama/llama-3.3-70b-instruct:free
# Note: 50 req/day free, 1000/day after one-time $10 credit top-up.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME="AIRSI AlgoTrader"

# AI: Pollinations keyless last resort (no key needed, free trial survival)
# Anon ~1 req/15s, basic models, no SLA. Commentary only, never trading signal.
# Set POLLINATIONS_DISABLED=1 to disable.
POLLINATIONS_MODEL=openai
# POLLINATIONS_DISABLED=0


# ── Execution venue (selectable) ─────────────────────────────────
# EXCHANGE picks which paper template / live exchange to use.
# Best for $5-10 micro in 2026: okx (0.08% maker) or binance (0.10%, 0.075% with BNB).
# kraken = regulatory trust but 0.25%/0.40% — avoid for active micro.
# For PAPER leave keys empty. For LIVE use trade-only keys, withdrawals OFF.
EXCHANGE=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Optional per-exchange overrides (preferred to avoid key mixups):
# EXCHANGE_BINANCE_KEY= / EXCHANGE_BINANCE_SECRET=
# EXCHANGE_KRAKEN_KEY= / EXCHANGE_KRAKEN_SECRET=
# EXCHANGE_OKX_KEY= / EXCHANGE_OKX_SECRET= / OKX_PASSPHRASE=

# ── Wallet attribution (future-proof, display-only today) ────────
# Freqtrade executes via CEX API keys, not browser-wallet signing.
# WALLET_MODE=custodial = live behavior today.
# self_custody_readonly = show funding wallet in dashboard, still CEX execution.
# self_custody_dex_reserved = paper-only, refuses live (needs Hummingbot Gateway later).
WALLET_MODE=custodial
WALLET_PROVIDER=none
WALLET_ADDRESS=
WALLET_CHAIN=base
# Never add SEED_PHRASE / PRIVATE_KEY / MNEMONIC here for this bot.


# ── Freqtrade REST API ─────────────────────────────────────────
# These protect the local Freqtrade UI/API (http://localhost:8080)
FREQTRADE_API_USER=your_freqtrade_api_user_here
FREQTRADE_API_PASS=your_strong_freqtrade_password_here
FREQTRADE_JWT_SECRET=generate_a_random_secret_at_least_64_characters


# ── Dashboard API Server ───────────────────────────────────────
FREQTRADE_API_URL=http://localhost:8080
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Live market intelligence ─────────────────────────────────
# Public market/news data plus optional free API LLM.
# Leave all AI keys empty to use deterministic risk rules only (recommended default).
# Pollinations keyless still tries as last resort unless POLLINATIONS_DISABLED=1.
# Do not set LLM_MODEL to a paid OpenAI model unless AI_ALLOW_PAID=1.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
NEWS_RSS_URLS=
INTELLIGENCE_POLL_SECONDS=900
INTELLIGENCE_TTL_SECONDS=1800
INTELLIGENCE_DECISION_PATH=bot/user_data/market_intelligence.json
# Missing or expired intelligence fails closed for live/dry-run entries.
# Backtests and hyperopt ignore external intelligence by design.
